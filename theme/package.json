{
  "name": "slidev-theme-plas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "slidev": ">=53.0.0"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "canvasWidth": 960,
      "aspectRatio": "16/9",
      "fonts": {
        "provider": "none",
        "sans": "Source Sans 3 Variable",
        "serif": "Source Serif 4 Variable",
        "mono": "JetBrains Mono Variable"
      },
      "transition": "fade",
      "highlighter": "shiki",
      "lineNumbers": false
    }
  },
  "dependencies": {
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-code-pro": "5.3.1",
    "qrcode": "1.5.4",
    "@slidev/parser": "53.1.0"
  },
  "bin": {
    "plas-check": "./bin/plas-check.mjs",
    "plas-export": "./bin/plas-export.mjs"
  },
  "peerDependencies": {
    "playwright-chromium": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright-chromium": {
      "optional": true
    }
  }
}
